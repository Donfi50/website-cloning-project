# Copy to .env  (cp .env.example .env)
DATABASE_URL=postgresql://videohub:videohub@localhost:5432/videohub
AUTH_SECRET=generate-with-openssl-rand-base64-32
APP_URL=http://localhost:3000
# Required whenever the app runs in production mode (next start, or any deployment outside Vercel); without it
# every sign-in fails with "UntrustedHost". When deployed, also set AUTH_URL to your public https address.
AUTH_TRUST_HOST=true
# AUTH_URL=https://your-domain.example

# Storage (matches docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videohub
S3_KEY=minioadmin
S3_SECRET=minioadmin
# Only when the browser must reach storage at a different address than the server does (e.g. GitHub Codespaces):
# S3_PUBLIC_ENDPOINT=
# MINIO_CORS_ORIGIN=
NEXT_PUBLIC_CDN_URL=http://localhost:9000/videohub

# Optional. Without SMTP_HOST, verification and reset links print in the server terminal.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=VideoHub <no-reply@example.com>

# Optional. Without these, rate limits run in memory (fine locally).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Shown on the legal pages (replace before launch)
NEXT_PUBLIC_SITE_NAME=VideoHub
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_COPYRIGHT_AGENT="Your Name, 123 Street, City, Country"
